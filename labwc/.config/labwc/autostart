#!/bin/sh

##############################
#       Autostart (dwl)      #
##############################

$XDG_CONFIG_HOME/autostart-cmds/autostart.sh &

#wlr-randr --output eDP-1 --scale 1.70
kanshi &
dbus-update-activation-environment --all
xprop -root -format _XWAYLAND_GLOBAL_OUTPUT_SCALE 32c -set _XWAYLAND_GLOBAL_OUTPUT_SCALE 2
echo "Xft.dpi: 192" | xrdb -merge
swayidle -w &
wayland-pipewire-idle-inhibit &
swaybg --image $HOME/Pictures/hutan-hujan-jalan.jpg --mode fit --color 02231c &
wl-paste --type text --watch cliphist store &
wl-paste --type image --watch cliphist store &
waybar &



