// Load with --config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type": "kitty",
      "source": "~/.config/fastfetch/crt-head-neo.png",
      "padding": {
          "top": 2,
          "left": 2
      }
    },
    "display": {
        "separator": "  ",
        "constants": [
            "─────────────────" // {$1}, used in Custom module
        ],
        "key": {
            "type": "icon",
            "paddingLeft": 2
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{$1}{$1} {#1}{user-name} on {host-name}{#} {$1}{$1}"
        },
        "break",
        {
            "type": "custom", // HardwareStart
            // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
            "format": "┌{$1}{$1} {#1}Hardware{#} {$1}{$1}┐"
        },
        "host",
        "cpu",
        "gpu",
        "disk",
        "memory",
        "display",
        {
            "type": "custom", // InformationEnd
            "format": "└{$1}{$1}──────────{$1}{$1}┘"
        },
        "break",
        {
            "type": "custom", // SoftwareStart
            "format": "┌{$1}{$1} {#1}System{#} {$1}{$1}┐"
        },
        "os",
        "kernel",
        "packages",
        "uptime",
        {
            "type": "custom", // InformationEnd
            "format": "└{$1}{$1}────────{$1}{$1}┘"
        },
        "break",
        {
            "type": "custom", // SoftwareStart
            "format": "┌{$1}{$1} {#1}Environment{#} {$1}{$1}┐"
        },
        "lm",
        "de",
        "wm",
        "shell",
        "terminal",
        "terminalfont",
        "theme",
        "icons",
        {
            "type": "custom", // InformationEnd
            "format": "└{$1}{$1}─────────────{$1}{$1}┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
