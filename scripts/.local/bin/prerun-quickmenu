#!/bin/sh

if pgrep -x rofi; then
    if pgrep -x quickmenu; then
        pkill -x rofi           # kill quickmenu if running
    else
        pkill -x rofi && quickmenu     # replace running instance of other rofi menu with quickmenu
    fi
else
    quickmenu  # just run quickmenu if no rofi instance is running
fi

# vim: ft=sh
